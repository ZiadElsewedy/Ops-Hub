{
  // The backend is chosen automatically by build mode (see
  // lib/core/config/app_environment.dart), so there are no per-environment
  // launch profiles needed for the normal development/production backend. The
  // explicit mock-data profile below is the only exception:
  //
  //   Debug   (these configs / `flutter run`)      → Development → localhost
  //   Release (`flutter build … --release`)         → Production  → Railway
  //
  // To test a debug build on a physical device against your Mac's LAN backend,
  // use the "OpsHub (device on LAN)" config below and edit the IP.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OpsHub (Development)",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "OpsHub (Mock data / Firebase emulators)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define=USE_FIREBASE_EMULATORS=true",
        "--dart-define=FIREBASE_EMULATOR_HOST=localhost"
      ]
    },
    {
      "name": "OpsHub (device on LAN)",
      "request": "launch",
      "type": "dart",
      "toolArgs": ["--dart-define=DEV_API_BASE_URL=http://192.168.1.8:3000"]
    },
    {
      "name": "OpsHub (Production, release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
